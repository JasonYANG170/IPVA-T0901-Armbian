 config/boards/rv1126-evb-v13.csc | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/config/boards/rv1126-evb-v13.csc b/config/boards/rv1126-evb-v13.csc
index 2900b10..ce42408 100644
--- a/config/boards/rv1126-evb-v13.csc
+++ b/config/boards/rv1126-evb-v13.csc
@@ -2,6 +2,8 @@
 BOARD_NAME="RV1126 EVB DDR3 V13"
 BOARD_VENDOR="Rockchip"
