++
++#include "rv1126-u-boot.dtsi"
++
++/ {
++	chosen {
++		u-boot,spl-boot-order = "same-as-spl", &sdmmc, &emmc;
++	};
++};
++
++&emmc {
++	bootph-pre-ram;
++};
++
++&emmc_bus8 {
++	bootph-pre-ram;
++};
++
++&emmc_clk {
++	bootph-pre-ram;
++};
++
++&emmc_cmd {
++	bootph-pre-ram;
++};
++
++&emmc_rstnout {
++	bootph-pre-ram;
++};
++
++&sdmmc {
++	bootph-pre-ram;
++};
++
++&sdmmc0_bus4 {
++	bootph-pre-ram;
++};
++
++&sdmmc0_clk {
++	bootph-pre-ram;
++};
++
++&sdmmc0_cmd {
++	bootph-pre-ram;
++};
++
++&sdio {
++	status = "disabled";
++};
++
++&uart2 {
++	bootph-pre-ram;
++};
+diff --git a/arch/arm/mach-rockchip/rv1126/Kconfig b/arch/arm/mach-rockchip/rv1126/Kconfig
+index 43eeaa9c..39373d0f 100644
