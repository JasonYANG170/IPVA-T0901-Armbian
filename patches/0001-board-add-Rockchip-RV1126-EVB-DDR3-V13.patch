++++ b/arch/arm/mach-rockchip/rv1126/Kconfig
+@@ -21,6 +21,12 @@ config TARGET_RV1126_SONOFF_IHOST
+ 	  It features Wifi, Bluetooth and Zigbee radios that are used by many
+ 	  smart home devices.
+ 
++config TARGET_RV1126_EVB_V13
++	bool "RV1126 EVB DDR3 V13"
++	help
++	  RV1126 EVB DDR3 V13 uses Rockchip RV1126 with DDR3, eMMC and a UART2 console.
++	  An SD card is supported when present on the carrier.
++
+ config SOC_SPECIFIC_OPTIONS # dummy
+ 	def_bool y
+ 	select HAS_CUSTOM_SYS_INIT_SP_ADDR
+@@ -63,5 +69,6 @@ config TEXT_BASE
+ 
+ source "board/edgeble/neural-compute-module-2/Kconfig"
+ source "board/itead/sonoff-ihost/Kconfig"
++source "board/rockchip/rv1126-evb-v13/Kconfig"
+ 
