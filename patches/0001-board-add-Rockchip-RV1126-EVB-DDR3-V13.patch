From b997c4913a88278d29210aa98ce3ab5b67162197 Mon Sep 17 00:00:00 2001
From: JasonYANG170 <39414350+JasonYANG170@users.noreply.github.com>
Date: Sun, 15 Nov 2026 23:40:03 +0800
Subject: [PATCH] board: add Rockchip RV1126 EVB DDR3 V13

Reuse the RV1126 vendor kernel and U-Boot family. Add the eMMC boot profile and describe RMII, the IMX335 camera, and the status LEDs.

Build the RV1126 camera pipeline and IMX335 driver as modules in the shared vendor kernel configuration.
---
 config/boards/rv1126-evb-v13.csc              |  12 +
 .../linux-rockchip-rv1126-vendor.config       |   9 +
 .../dt/rv1126-evb-v13-armbian.dts             | 135 ++++++++
 .../add-board-rv1126-evb-v13.patch            | 308 ++++++++++++++++++
 4 files changed, 464 insertions(+)
 create mode 100644 config/boards/rv1126-evb-v13.csc
 create mode 100644 patch/kernel/rv1126-vendor-6.1/dt/rv1126-evb-v13-armbian.dts
 create mode 100644 patch/u-boot/v2026.07/board_rv1126-evb-v13/add-board-rv1126-evb-v13.patch

diff --git a/config/boards/rv1126-evb-v13.csc b/config/boards/rv1126-evb-v13.csc
new file mode 100644
index 0000000..2900b10
--- /dev/null
+++ b/config/boards/rv1126-evb-v13.csc
@@ -0,0 +1,12 @@
+# Rockchip RV1126 quad-core Cortex-A7 vendor EVB DDR3 V13 hardware profile
+BOARD_NAME="RV1126 EVB DDR3 V13"
+BOARD_VENDOR="Rockchip"
+BOARDFAMILY="rockchip-rv1126"
+KERNEL_TARGET="vendor"
+KERNEL_TEST_TARGET="vendor"
+BOOT_FDT_FILE="rv1126-evb-v13-armbian.dtb"
+BOOTCONFIG="rv1126-evb-v13_defconfig"
+IMAGE_PARTITION_TABLE="gpt"
+
+# The vendor ISP and ISPP drivers do not export OF module aliases.
+MODULES_VENDOR="video_rkisp video_rkispp"
diff --git a/config/kernel/linux-rockchip-rv1126-vendor.config b/config/kernel/linux-rockchip-rv1126-vendor.config
index 71a616b..13443bc 100644
--- a/config/kernel/linux-rockchip-rv1126-vendor.config
+++ b/config/kernel/linux-rockchip-rv1126-vendor.config
@@ -444,6 +444,15 @@ CONFIG_MEDIA_SUPPORT=y
 CONFIG_MEDIA_SUPPORT_FILTER=y
 CONFIG_MEDIA_CAMERA_SUPPORT=y
 CONFIG_MEDIA_USB_SUPPORT=y
+CONFIG_MEDIA_PLATFORM_SUPPORT=y
+CONFIG_MEDIA_PLATFORM_DRIVERS=y
+CONFIG_V4L_PLATFORM_DRIVERS=y
+CONFIG_VIDEO_ROCKCHIP_CIF=m
+CONFIG_VIDEO_ROCKCHIP_ISP=m
+CONFIG_VIDEO_ROCKCHIP_ISP_VERSION_V20=y
+CONFIG_VIDEO_ROCKCHIP_ISPP=m
+CONFIG_VIDEO_ROCKCHIP_ISPP_VERSION_V10=y
+CONFIG_VIDEO_IMX335=m
 CONFIG_USB_VIDEO_CLASS=y
 CONFIG_VIDEO_GC2053=y
 CONFIG_VIDEO_GC2093=y
diff --git a/patch/kernel/rv1126-vendor-6.1/dt/rv1126-evb-v13-armbian.dts b/patch/kernel/rv1126-vendor-6.1/dt/rv1126-evb-v13-armbian.dts
new file mode 100644
index 0000000..5bc52da
--- /dev/null
+++ b/patch/kernel/rv1126-vendor-6.1/dt/rv1126-evb-v13-armbian.dts
@@ -0,0 +1,135 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/dts-v1/;
+
+#include <dt-bindings/leds/common.h>
+
+#include "rv1126.dtsi"
+#include "rv1126-evb-v13.dtsi"
+
+/ {
+	model = "Rockchip RV1126 EVB DDR3 V13";
+	compatible = "rockchip,rv1126-evb-ddr3-v13", "rockchip,rv1126";
+
+	aliases {
+		ethernet0 = &gmac;
+		serial2 = &uart2;
+	};
+
+	chosen {
+		stdout-path = "serial2:1500000n8";
+	};
+
+	leds {
+		compatible = "gpio-leds";
+
+		led-0 {
+			function = LED_FUNCTION_STATUS;
+			color = <LED_COLOR_ID_YELLOW>;
+			gpios = <&gpio1 RK_PD6 GPIO_ACTIVE_LOW>;
+			default-state = "off";
+		};
+
+		led-1 {
+			function = LED_FUNCTION_STATUS;
+			color = <LED_COLOR_ID_BLUE>;
+			gpios = <&gpio2 RK_PA0 GPIO_ACTIVE_LOW>;
+			default-state = "off";
+		};
+	};
+};
+
+&fiq_debugger {
+	status = "disabled";
+};
+
+&uart2 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&uart2m1_xfer>;
+	status = "okay";
+};
+
+&gmac {
+	phy-mode = "rmii";
+	clock_in_out = "output";
+	snps,reset-gpio = <&gpio3 RK_PC5 GPIO_ACTIVE_LOW>;
+	snps,reset-delays-us = <0 50000 50000>;
+	assigned-clocks = <&cru CLK_GMAC_SRC>, <&cru CLK_GMAC_TX_RX>;
+	assigned-clock-parents = <&cru CLK_GMAC_SRC_M0>, <&cru RMII_MODE_CLK>;
+	assigned-clock-rates = <50000000>;
+	pinctrl-0 = <&rmiim0_miim &rmiim0_bus2 &rmii_extra_pins>;
+	/delete-property/ tx_delay;
+	/delete-property/ rx_delay;
+};
+
+&pinctrl {
+	ethernet {
+		rmii_extra_pins: rmii-extra-pins {
+			rockchip,pins = <3 RK_PC0 2 &pcfg_pull_none_drv_level_0>,
+					<3 RK_PC2 2 &pcfg_pull_none>;
+		};
+	};
+};
+
+&usbdrd_dwc3 {
+	dr_mode = "host";
+};
+
+&sfc {
+	status = "disabled";
+};
+
+&wireless_wlan {
+	status = "disabled";
+};
+
+/* This board uses the IMX335 in place of the EVB sensor options. */
+&ar0230 {
+	status = "disabled";
+};
+
+&ov4689 {
+	status = "disabled";
+};
+
+&os04a10 {
+	status = "disabled";
+};
+
+&csi_dphy1 {
+	status = "disabled";
+};
+
+&mipi_in_ucam0 {
+	remote-endpoint = <&imx335_out>;
+};
+
+&i2c1 {
+	imx335@1a {
+		compatible = "sony,imx335";
+		reg = <0x1a>;
+		clocks = <&cru CLK_MIPICSI_OUT>;
+		clock-names = "xvclk";
+		power-domains = <&power RV1126_PD_VI>;
+		pinctrl-names = "rockchip,camera_default";
+		pinctrl-0 = <&mipicsi_clk0>;
+		avdd-supply = <&vcc_avdd>;
+		dovdd-supply = <&vcc_dovdd>;
+		dvdd-supply = <&vcc_dvdd>;
+		reset-gpios = <&gpio1 RK_PD5 GPIO_ACTIVE_LOW>;
+		rockchip,camera-module-index = <1>;
+		rockchip,camera-module-facing = "front";
+		rockchip,camera-module-name = "MTV4-IR-E-P";
+		rockchip,camera-module-lens-name = "40IRC-4MP-F16";
+
+		port {
+			imx335_out: endpoint {
+				remote-endpoint = <&mipi_in_ucam0>;
+				data-lanes = <1 2 3 4>;
+			};
+		};
+	};
+};
+
+&mipi_csi2_hw {
+	status = "okay";
+};
diff --git a/patch/u-boot/v2026.07/board_rv1126-evb-v13/add-board-rv1126-evb-v13.patch b/patch/u-boot/v2026.07/board_rv1126-evb-v13/add-board-rv1126-evb-v13.patch
