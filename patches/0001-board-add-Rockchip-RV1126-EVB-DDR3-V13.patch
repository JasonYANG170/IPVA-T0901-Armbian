+ create mode 100644 configs/rv1126-evb-v13_defconfig
+ create mode 100644 dts/upstream/src/arm/rockchip/rv1126-evb-v13.dts
+ create mode 100644 include/configs/rv1126-evb-v13.h
+
+diff --git a/arch/arm/dts/rv1126-evb-v13-u-boot.dtsi b/arch/arm/dts/rv1126-evb-v13-u-boot.dtsi
+new file mode 100644
