diff --git a/kernel-module-imx-gpu-viv-src/hal/os/linux/kernel/platform/rockchip/gc_hal_kernel_platform_rv1126.c b/kernel-module-imx-gpu-viv-src/hal/os/linux/kernel/platform/rockchip/gc_hal_kernel_platform_rv1126.c
new file mode 100644
index 0000000..9349630
--- /dev/null
+++ b/kernel-module-imx-gpu-viv-src/hal/os/linux/kernel/platform/rockchip/gc_hal_kernel_platform_rv1126.c
@@ -0,0 +1,109 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include <linux/clk.h>
+#include <linux/of.h>
+#include <linux/pm_runtime.h>
+#include <linux/regulator/consumer.h>
+
+#include "gc_hal_kernel_linux.h"
+#include "gc_hal_kernel_platform.h"
+
+static struct {
+    struct regulator *supply;
+    struct clk_bulk_data *clocks;
+    struct resource *registers;
+    int clock_count;
+    int irq;
+} rv1126;
+
+static gceSTATUS rv1126_get_power(gcsPLATFORM *platform)
+{
+    struct platform_device *pdev = platform->device;
+    struct device *dev = &pdev->dev;
+    int ret;
+
+    if (!of_machine_is_compatible("rockchip,rv1126"))
+        return gcvSTATUS_NOT_SUPPORTED;
+
+    rv1126.registers = platform_get_resource(pdev, IORESOURCE_MEM, 0);
+    rv1126.irq = platform_get_irq(pdev, 0);
+    if (!rv1126.registers || rv1126.irq < 0)
+        return gcvSTATUS_NOT_FOUND;
+
+    rv1126.supply = devm_regulator_get(dev, "npu");
+    if (IS_ERR(rv1126.supply))
+        return gcvSTATUS_NOT_SUPPORTED;
+
+    rv1126.clock_count = devm_clk_bulk_get_all(dev, &rv1126.clocks);
+    if (rv1126.clock_count != 4)
+        return gcvSTATUS_NOT_SUPPORTED;
+
+    ret = regulator_enable(rv1126.supply);
+    if (ret)
+        return gcvSTATUS_NOT_SUPPORTED;
+
+    pm_runtime_enable(dev);
+    ret = pm_runtime_resume_and_get(dev);
+    if (ret < 0)
+        goto disable_runtime_pm;
+
+    ret = clk_bulk_prepare_enable(rv1126.clock_count, rv1126.clocks);
+    if (ret)
+        goto put_runtime_pm;
+
+    return gcvSTATUS_OK;
+
+put_runtime_pm:
+    pm_runtime_put_sync(dev);
+disable_runtime_pm:
+    pm_runtime_disable(dev);
+    regulator_disable(rv1126.supply);
+    return gcvSTATUS_NOT_SUPPORTED;
+}
+
+static gceSTATUS rv1126_put_power(gcsPLATFORM *platform)
+{
+    struct device *dev = &platform->device->dev;
+
+    clk_bulk_disable_unprepare(rv1126.clock_count, rv1126.clocks);
+    pm_runtime_put_sync(dev);
+    pm_runtime_disable(dev);
+    regulator_disable(rv1126.supply);
+    return gcvSTATUS_OK;
+}
+
+static gceSTATUS rv1126_adjust_param(gcsPLATFORM *platform, gcsMODULE_PARAMETERS *args)
+{
+    args->irqs[gcvCORE_MAJOR] = rv1126.irq;
+    args->registerBases[gcvCORE_MAJOR] = rv1126.registers->start;
+    args->registerSizes[gcvCORE_MAJOR] = resource_size(rv1126.registers);
+    return gcvSTATUS_OK;
+}
+
+static struct _gcsPLATFORM_OPERATIONS rv1126_ops = {
+    .adjustParam = rv1126_adjust_param,
+    .getPower = rv1126_get_power,
+    .putPower = rv1126_put_power,
+};
+
+static gcsPLATFORM rv1126_platform = {
+    .name = "rv1126",
+    .ops = &rv1126_ops,
+};
+
+static const struct of_device_id rv1126_match[] = {
+    { .compatible = "rockchip,npu" },
+    {}
+};
+MODULE_DEVICE_TABLE(of, rv1126_match);
+
+int gckPLATFORM_Init(struct platform_driver *driver, gcsPLATFORM **platform)
+{
+    driver->driver.of_match_table = rv1126_match;
+    *platform = &rv1126_platform;
+    return 0;
+}
+
+int gckPLATFORM_Terminate(gcsPLATFORM *platform)
+{
+    return 0;
+}
